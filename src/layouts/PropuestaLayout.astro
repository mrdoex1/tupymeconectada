---
import '../styles/propuesta.css';
import { site } from '../data/site';
import { planes } from '../data/planes';
import { faqGroups } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Páginas Web para Pymes en Chile desde $79.990 | Tu Pyme Conectada',
  description = 'Páginas web para pymes en Chile: One Page desde $79.990, lista en 3 a 5 días hábiles y con botón directo a WhatsApp. Precios claros y sin letra chica.',
} = Astro.props;

const SERVICE_DESCRIPTIONS: Record<string, string> = {
  'one-page-esencial':
    'Página web de una sola sección con botón a WhatsApp, lista en 3 a 5 días hábiles.',
  'one-page-pro':
    'One Page con redacción de textos, mapa, formulario, galería y configuración de Google Search Console.',
  'catalogo-whatsapp':
    'Catálogo online de hasta 30 productos con pedidos directo a WhatsApp.',
  'sitio-corporativo':
    'Sitio web de hasta 4 páginas con formulario y botón de WhatsApp.',
  mantenimiento:
    'Plan mensual con respaldos, seguridad, velocidad, SEO técnico y 2 horas de cambios.',
};

// "desde" = precio mínimo; Mantenimiento = precio mensual.
function offerPrice(plan: (typeof planes)[number]) {
  if (plan.precioNota === 'al mes') {
    return {
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: plan.esPrecio,
        priceCurrency: 'CLP',
        unitCode: 'MON',
      },
    };
  }
  if (plan.desde) {
    return {
      priceSpecification: {
        '@type': 'PriceSpecification',
        minPrice: plan.esPrecio,
        priceCurrency: 'CLP',
      },
    };
  }
  return { price: plan.esPrecio, priceCurrency: 'CLP' };
}

const BUSINESS_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://tupymeconectada.cl/#negocio',
  name: 'Tu Pyme Conectada',
  url: 'https://tupymeconectada.cl/',
  logo: 'https://tupymeconectada.cl/recursos/imagenes/logoTPC-dark.png',
  image: 'https://tupymeconectada.cl/recursos/imagenes/bannerFacebook-v2.jpg',
  description:
    'Diseño de páginas web para pymes en Chile: One Page, catálogos con pedidos por WhatsApp, sitios corporativos y mantenimiento web.',
  telephone: '+56973173721',
  email: site.email,
  priceRange: '$79.990 - $249.990',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Santiago',
    addressRegion: 'Región Metropolitana',
    addressCountry: 'CL',
  },
  areaServed: { '@type': 'Country', name: 'Chile' },
  sameAs: [site.instagram],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Planes de páginas web',
    itemListElement: planes.map((plan) => ({
      '@type': 'Offer',
      name: plan.nombre,
      ...offerPrice(plan),
      itemOffered: {
        '@type': 'Service',
        name: plan.nombre,
        description: SERVICE_DESCRIPTIONS[plan.id],
      },
    })),
  },
};

const FAQ_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((group) =>
    group.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: { '@type': 'Answer', text: faq.a },
    }))
  ),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://tupymeconectada.cl/" />
    <meta name="theme-color" content="#0e1726" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://tupymeconectada.cl/recursos/imagenes/bannerFacebook-v2.jpg"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tu Pyme Conectada" />
    <meta property="og:url" content="https://tupymeconectada.cl/" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://tupymeconectada.cl/recursos/imagenes/bannerFacebook-v2.jpg"
    />
    <title>{title}</title>

    <link rel="apple-touch-icon" sizes="180x180" href="/recursos/imagenes/apple-touch-icon.png" />
    <link rel="icon" type="image/x-icon" href="/recursos/imagenes/favicon.ico" />
    <link rel="icon" type="image/png" href="/recursos/imagenes/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gelasio:wght@400;500;600;700&family=Karla:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(BUSINESS_JSONLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(FAQ_JSONLD)} />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/propuesta.js';
    </script>
  </body>
</html>