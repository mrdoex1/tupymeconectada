---
import '../styles/propuesta.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tu Pyme Conectada | Sitios web para PYMES en Chile',
  description = 'Sitios web limpios, rápidos y enfocados en vender más. Diseño web, rediseño, mantenimiento y SEO local para pymes.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://tupymeconectada.cl/recursos/imagenes/bannerFacebook.png"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tupymeconectada.cl" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Karla:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Caveat:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/recursos/imagenes/favicon.png" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/propuesta.js';
    </script>
  </body>
</html>