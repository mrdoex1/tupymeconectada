---
import '@tabler/icons-webfont/dist/tabler-icons.min.css';
const title = '404 | Tu Pyme Conectada';
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/recursos/imagenes/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gelasio:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Karla:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --text-light: #0f172a;
        --text-light-muted: #475569;
        --card-light: #ffffff;
        --border-light: rgba(15, 23, 42, 0.08);
        --shadow-light: 0 20px 50px rgba(15, 23, 42, 0.08);
        --primary: #00a3ff;
        --primary-light: #3bb8ff;
        --transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      }
      body {
        background: linear-gradient(180deg, #ffffff 0%, #eef4fb 100%);
        color: var(--text-light);
        font-family: "Karla", system-ui, sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .error-card {
        background: var(--card-light);
        border: 1px solid var(--border-light);
        border-radius: 24px;
        box-shadow: var(--shadow-light);
        max-width: 480px;
        width: 100%;
        padding: 45px 32px;
        text-align: center;
      }

      .logo-img {
        height: 48px;
        width: auto;
        max-width: 100%;
        object-fit: contain;
        margin-bottom: 25px;
      }

      .error-code {
        font-family: "Gelasio", Georgia, serif;
        font-size: 4.5rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--primary);
        margin-bottom: 12px;
      }

      .error-title {
        font-family: "Gelasio", Georgia, serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-light);
        margin-bottom: 12px;
      }

      .error-text {
        color: var(--text-light-muted);
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 30px;
      }

      .error-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 15px 30px;
        border-radius: 14px;
        font-weight: 600;
        font-size: 0.9rem;
        text-decoration: none;
        transition: var(--transition);
      }

      .btn i {
        font-size: 1.1rem;
      }

      .btn-home {
        background: var(--primary);
        color: #000;
      }

      .btn-home:hover {
        background: var(--primary-light);
        transform: translateY(-2px);
      }

      .btn-whatsapp {
        background: #25d366;
        color: #fff;
      }

      .btn-whatsapp:hover {
        background: #2ee06f;
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <div class="error-card">
      <img
        src="/recursos/imagenes/logoTPC-dark.png"
        alt="Logo Tu Pyme Conectada"
        class="logo-img"
      />
      <p class="error-code">404</p>
      <h1 class="error-title">Página no encontrada</h1>
      <p class="error-text">
        La página que buscas no existe o fue movida.
        No te preocupes, podemos volver a tu sitio o conversar por WhatsApp.
      </p>
      <div class="error-buttons">
        <a href="/" class="btn btn-home">
          <i class="ti ti-home"></i> Volver al inicio
        </a>
        <a
          href="https://wa.me/56973173721?text=Hola,%20me%20perdí%20en%20tu%20sitio%20web"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <i class="ti ti-brand-whatsapp"></i> Escríbeme por WhatsApp
        </a>
      </div>
    </div>
  </body>
</html>