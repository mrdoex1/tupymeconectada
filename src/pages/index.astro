---
import PropuestaLayout from '../layouts/PropuestaLayout.astro';
import Header from '../components/propuesta/Header.astro';
import Hero from '../components/propuesta/Hero.astro';
import TechStrip from '../components/propuesta/TechStrip.astro';
import Servicios from '../components/propuesta/Servicios.astro';
import Proceso from '../components/propuesta/Proceso.astro';
import Testimonios from '../components/propuesta/Testimonios.astro';
import SobreMi from '../components/propuesta/SobreMi.astro';
import Faq from '../components/propuesta/Faq.astro';
import Contacto from '../components/propuesta/Contacto.astro';
import Footer from '../components/propuesta/Footer.astro';
---

<PropuestaLayout>
  <Header />
  <main id="contenido">
    <Hero />
    <TechStrip />
    <Servicios />
    <Proceso />
    <Testimonios />
    <SobreMi />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</PropuestaLayout>