---

<section id="contacto" class="full-section light-section">
      <div class="section-inner">
        <div class="section-header" style="margin-bottom: 50px">
          <div class="section-title-group">
            <h2>Contacto</h2>
          </div>
        </div>
        <div class="contact-layout">
          <div class="contact-info">
            <p>
              Escríbeme directamente o déjame tus datos en el formulario para
              conversar sobre tu próximo sitio web.
            </p>
            <ul class="contact-list">
              <li><a href="https://wa.me/56959909150" target="_blank" rel="noopener noreferrer"><i class="ti ti-brand-whatsapp"></i> +56 9 5990 9150</a></li>
              <li><a href="mailto:contacto@tupymeconectada.cl"><i class="ti ti-mail"></i> contacto@tupymeconectada.cl</a></li>
              <li><a href="https://www.instagram.com/tupymeconectada/" target="_blank" rel="noopener noreferrer"><i class="ti ti-brand-instagram"></i> @tupymeconectada</a></li>
              <li><span class="contact-static"><i class="ti ti-map-pin"></i> Estoy disponible para ayudarte no importa donde estés (Chile)</span></li>
            </ul>
          </div>
          <div class="contact-form">
            <form id="formContacto">
              <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" required placeholder="Ingresa tu nombre" />
              </div>
              <div class="form-group">
                <label for="servicio">Servicio de interés</label>
                <select id="servicio" required>
                  <option value="" disabled selected>Selecciona una opción</option>
                  <option value="Diseño y Desarrollo Web">Diseño y Desarrollo Web</option>
                  <option value="Optimización y Rediseño Web">Optimización y Rediseño Web</option>
                  <option value="Mantenimiento y Cuidado Web">Mantenimiento y Cuidado Web</option>
                  <option value="Configuración Digital y SEO Local">Configuración Digital y SEO Local</option>
                </select>
              </div>
              <div class="form-group">
                <label for="mensaje">Mensaje</label>
                <textarea id="mensaje" required placeholder="Cuéntame qué necesitas..."></textarea>
              </div>
              <button type="submit" class="form-btn">
                <i class="ti ti-brand-whatsapp" style="margin-right: 8px;"></i> Enviar consulta
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
