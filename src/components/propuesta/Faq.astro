---
import { faqGroups } from '../../data/faq';
---

<section id="faq" class="pp-section pp-section--dark">
  <div class="pp-inner">
    <div class="pp-head">
      <h2>Preguntas frecuentes sobre páginas web</h2>
      <p>Todo lo que necesitas saber antes de empezar</p>
    </div>

    <div class="pp-chips pp-reveal" role="group" aria-label="Filtrar preguntas">
      {faqGroups.map((group, i) => (
        <button
          class:list={['pp-chip', { active: i === 0 }]}
          data-filter={group.id}
          aria-pressed={i === 0}
        >
          {group.etiqueta}
        </button>
      ))}
    </div>

    {faqGroups.map((group, i) => (
      <div class="pp-faq-group" data-group={group.id} hidden={i !== 0}>
        <h3 class="pp-faq-group-title">
          <i class={group.icono} aria-hidden="true"></i> {group.etiqueta}
        </h3>
        {group.faqs.map((faq) => (
          <div class="pp-faq-item">
            <button class="pp-faq-q" aria-expanded="false">
              {faq.q}
              <i class="ti ti-chevron-down" aria-hidden="true"></i>
            </button>
            <div class="pp-faq-a">
              <div class="pp-faq-a-inner">
                <p>{faq.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    ))}
  </div>
</section>