---
import { site } from '../../data/site';
---

<section id="contacto" class="pp-section pp-section--paper pp-contacto-cierre">
  <div class="pp-inner">
    <div class="pp-cierre pp-reveal">
      <div class="pp-cierre-card">
        <div class="pp-cierre-copy">
          <span class="pp-cierre-kicker">La última palabra</span>
          <h2 class="pp-cierre-title">¿Conversamos sobre tu web?</h2>
          <p class="pp-cierre-text">
            Escríbenos por WhatsApp y te respondemos con una propuesta y un plazo
            por escrito, sin compromiso.
          </p>
          <span class="pp-cierre-avail"><i class="pp-cierre-dot" aria-hidden="true"></i> Disponibles para tu proyecto</span>
        </div>

        <div class="pp-cierre-actions">
          <a
            href={site.whatsapp.general}
            class="pp-cierre-wa"
            target="_blank"
            rel="noopener noreferrer"
            ><i class="ti ti-brand-whatsapp" aria-hidden="true"></i> Cotizar por
            WhatsApp</a
          >
          <p class="pp-cierre-hint">Escríbenos a tu canal favorito</p>
          <div class="pp-cierre-ch">
            <a href={`mailto:${site.email}`} class="pp-cierre-ch-link" title="Correo" aria-label="Enviar un correo"
              ><i class="ti ti-mail" aria-hidden="true"></i></a
            >
            <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="pp-cierre-ch-link" title="Instagram" aria-label="Ir a Instagram"
              ><i class="ti ti-brand-instagram" aria-hidden="true"></i></a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</section>