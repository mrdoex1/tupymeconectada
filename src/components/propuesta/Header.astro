---
import { site } from '../../data/site';
---

<header class="pp-header">
  <a href="#top" class="pp-logo" aria-label="Inicio">
    <img
      src="/recursos/imagenes/logoTPC-dark.webp"
      alt="Logo Tu Pyme Conectada"
      width="107"
      height="30"
    />
  </a>

  <nav class="pp-nav" id="ppNav" aria-label="Navegación principal">
    <a href="#trabajos">Trabajos</a>
    <a href="#servicios">Planes y precios</a>
    <a href="#proceso">Proceso</a>
    <a href="#quienes-somos">Nosotros</a>
    <a href="#faq">FAQ</a>
  </nav>

  <div class="pp-nav-actions">
    <a
      href={site.instagram}
      target="_blank"
      rel="noopener noreferrer"
      class="pp-social"
      title="Instagram"
      aria-label="Ir a Instagram"
      ><i class="ti ti-brand-instagram" aria-hidden="true"></i
    ></a>
    <a
      href={site.whatsapp.general}
      class="pp-btn pp-btn--primary"
      target="_blank"
      rel="noopener noreferrer"
      ><i class="ti ti-brand-whatsapp" aria-hidden="true"></i> Cotizar</a
    >
    <button class="pp-menu-btn" id="ppMenuBtn" aria-label="Abrir menú de navegación" aria-expanded="false">
      <i class="ti ti-menu-2" aria-hidden="true"></i>
    </button>
  </div>
</header>