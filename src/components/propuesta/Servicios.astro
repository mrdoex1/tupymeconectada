---
import { site } from '../../data/site';
import { planes, buenoSaber, proyectosAMedida } from '../../data/planes';
---

<section id="servicios" class="pp-section pp-section--dark">
  <div class="pp-inner">
    <div class="pp-head pp-reveal">
      <h2>Planes y precios de páginas web para pymes</h2>
      <p>
        Precios fijos y publicados. Sabes desde el inicio cuánto pagas, qué
        incluye y cuándo está lista tu web.
      </p>
    </div>

    <div class="servicios-carousel pp-reveal">
      <button class="carousel-btn prev" id="srvPrevBtn" aria-label="Servicio anterior"><i class="ti ti-chevron-left"></i></button>
      <div class="pricing-wrap" id="pricingWrap">
        {planes.map((plan) => (
          <div
            id={`plan-${plan.id}`}
            class:list={[
              'pricing-card',
              { 'pricing-card--feature': plan.feature },
              { 'pricing-card--wide': plan.ancho },
            ]}
          >
            {plan.destacado && (
              <span class="pricing-badge">Recomendado</span>
            )}
            <h3 class="pricing-title">{plan.nombre}</h3>
            <p class="pricing-bajada">{plan.bajada}</p>
            <div class="pricing-price">
              {plan.desde && <span class="pricing-from">desde</span>}
              <span class="amount">${plan.precio}</span>
              <span class="note">{plan.precioNota}</span>
            </div>
            {plan.plazo && (
              <p class="pricing-plazo"><i class="ti ti-calendar-time" aria-hidden="true"></i> {plan.plazo}</p>
            )}
            {plan.condicion && (
              <p class="pricing-condicion"><i class="ti ti-circle-check" aria-hidden="true"></i> {plan.condicion}</p>
            )}
            {plan.paraQuien && (
              <div class="pricing-audience">
                <p>{plan.paraQuien}</p>
              </div>
            )}
            <ul class="pricing-features">
              {plan.incluyeLead && <li class="pricing-lead">{plan.incluyeLead}</li>}
              {plan.incluye.map((item) => (
                <li><i class="ti ti-circle-check" aria-hidden="true"></i><span>{item}</span></li>
              ))}
            </ul>
            <p class="pricing-exclude">{plan.noIncluye}</p>
            <div class="pricing-actions">
              <a class="pricing-cta" href={site.whatsapp[plan.whatsappKey]} target="_blank" rel="noopener noreferrer">
                <i class="ti ti-brand-whatsapp"></i> {plan.boton}
              </a>
            </div>
          </div>
        ))}
      </div>
      <button class="carousel-btn next" id="srvNextBtn" aria-label="Servicio siguiente"><i class="ti ti-chevron-right"></i></button>
    </div>

    <div class="pp-srv-dots" id="ppSrvDots" aria-live="polite" role="tablist" aria-label="Navegación de servicios">
      {planes.map((_, i) => (
        <button class="pp-srv-dot" aria-label={`Ir a servicio ${i + 1}`} data-index={i} aria-current={i === 0}></button>
      ))}
    </div>

    <div class="pp-buenosaber pp-reveal">
      <h3>Bueno saber antes de cotizar</h3>
      <div class="pp-buenosaber-grid">
        {buenoSaber.map((item) => (
          <div class="pp-buenosaber-item">
            <b>{item.titulo}</b>
            <p>{item.texto}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="pp-medida pp-reveal">
      <p>{proyectosAMedida.texto}</p>
      <a class="pp-btn pp-btn--outline" href={site.whatsapp.aMedida} target="_blank" rel="noopener noreferrer">
        {proyectosAMedida.boton} <i class="ti ti-arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>